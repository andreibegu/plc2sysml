{
  "physical_model": "physical",
  "root_definition": "CellStructure::Cell",
  "system_name": "TransferCell",
  "bindings": [
    {
      "source": "IO.inSensor",
      "targets": [
        "conveyor.entrySensor"
      ],
      "name": "atEntry"
    },
    {
      "source": "IO.outSensor",
      "targets": [
        "conveyor.exitSensor"
      ],
      "name": "atExit"
    },
    {
      "source": "IO.doorSensor",
      "targets": [
        "conveyor.doorSwitch"
      ],
      "name": "doorClosed"
    },
    {
      "source": "IO.downstreamBusy",
      "targets": [
        "conveyor.downstreamSensor"
      ],
      "name": "downstreamBusy"
    },
    {
      "source": "IO.motorCmd",
      "targets": [
        "conveyor.drive"
      ],
      "name": "motor"
    }
  ]
}
